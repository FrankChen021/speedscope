{
  "name": "@frankchen029/speedscope",
  "version": "1.23.103",
  "description": "Interactive flamegraph visualization component for React - converted from Preact",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrankChen021/speedscope.git"
  },
  "homepage": "https://github.com/FrankChen021/speedscope#readme",
  "bugs": {
    "url": "https://github.com/FrankChen021/speedscope/issues"
  },
  "keywords": [
    "flamegraph",
    "flame-graph",
    "profiling",
    "performance",
    "react",
    "visualization",
    "chrome",
    "firefox",
    "safari",
    "profile",
    "cpu-profile",
    "webgl"
  ],
  "main": "dist/lib/index.js",
  "module": "dist/lib/index.esm.js",
  "types": "dist/lib/index.d.ts",
  "bin": {
    "speedscope": "bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.esm.js",
      "require": "./dist/lib/index.js"
    },
    "./standalone": {
      "types": "./dist/lib/standalone.d.ts",
      "import": "./dist/lib/standalone.esm.js",
      "require": "./dist/lib/standalone.js"
    },
    "./assets/reset.css": "./dist/lib/assets/reset.css",
    "./assets/source-code-pro.css": "./dist/lib/assets/source-code-pro.css"
  },
  "scripts": {
    "deploy": "./scripts/deploy.sh",
    "build:release": "./scripts/prepack.sh --outdir \"$(pwd)/dist/release\" --protocol file",
    "build": "npm run build:release",
    "build:lib": "tsx scripts/build-lib.ts",
    "prepublishOnly": "npm run typecheck && npm run build:lib",
    "prettier": "prettier --write 'src/**/*.ts' 'src/**/*.tsx'",
    "lint": "eslint 'src/**/*.ts' 'src/**/*.tsx'",
    "jest": "./scripts/test-setup.sh && jest --runInBand",
    "coverage": "npm run jest -- --coverage",
    "typecheck": "tsc --noEmit",
    "test": "./scripts/ci.sh",
    "serve": "tsx scripts/dev-server.ts",
    "test:standalone": "tsx scripts/test-server.ts"
  },
  "files": [
    "dist/lib/**/*",
    "bin/cli.mjs",
    "README.md",
    "LICENSE"
  ],
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions"
  ],
  "author": "Frank Chen <frankchen021@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/jest": "22.2.3",
    "@types/jszip": "3.1.4",
    "@types/node": "14.0.1",
    "@types/pako": "1.0.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@typescript-eslint/eslint-plugin": "6.16.0",
    "@typescript-eslint/parser": "6.16.0",
    "acorn": "7.2.0",
    "aphrodite": "2.1.0",
    "esbuild": "0.24.2",
    "eslint": "8.0.0",
    "eslint-plugin-prettier": "5.1.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "jest": "24.3.0",
    "jsverify": "0.8.3",
    "jszip": "3.1.5",
    "pako": "1.0.6",
    "prettier": "3.1.1",
    "protobufjs": "6.8.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "source-map": "0.6.1",
    "ts-jest": "24.3.0",
    "tsx": "4.19.2",
    "typescript": "5.3.3",
    "typescript-json-schema": "0.42.0",
    "uglify-es": "3.2.2",
    "uint8array-json-parser": "0.0.2"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "setupFilesAfterEnv": [
      "./src/jest-setup.js"
    ],
    "testRegex": "\\.test\\.tsx?$",
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.{ts,tsx}"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "dependencies": {
    "aphrodite": "^2.1.0",
    "open": "10.1.0"
  }
}
